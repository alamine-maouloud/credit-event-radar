# Secrets
.env

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Project data (raw snapshots and database are never committed)
data/raw/*
!data/raw/.gitkeep
data/radar.db
data/*.db
data/llm_cache/
outputs/*
!outputs/.gitkeep

# OS
.DS_Store

# Private golden fixtures (issuer and agency documents): manifests are committed, bytes are not (ADR-010)
tests/fixtures/ir/*/document.*
tests/fixtures/gold/**/document.*
# SEC filings fetched after 2026-10-06 follow the same policy; the two earlier public fixtures stay committed
tests/fixtures/edgar/*/document.*
!tests/fixtures/edgar/harley_davidson_inc_10q_2026q2/document.*
!tests/fixtures/edgar/synthetic_issuer_test_a_10q/document.*

# benchmark dry runs are estimates only, real runs are committed as evidence
eval/runs/dry-*/
# raw model outputs carry verbatim excerpts of private documents: local only, results.jsonl is the sanitised copy
eval/runs/*/outputs.jsonl
# every .env variant (backups included) holds secrets
.env.*
!.env.example

# demo database raw snapshots (rebuilt by scripts/build_demo_db.py)
data/raw-demo/
