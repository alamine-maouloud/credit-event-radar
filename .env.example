# Copy to .env and fill in. Never commit .env.

# LLM backends (at least one is required from Phase 3 onwards)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=

# Hard cap on LLM spend for one run, in USD. The runner refuses any call that would exceed it,
# before the call is made. No value means no LLM call at all.
LLM_RUN_BUDGET_USD=10.00

# SEC EDGAR requires a declared User-Agent with a contact address, max 10 requests/second
SEC_USER_AGENT="Credit Event Radar (student research project) contact@example.com"
# Issuer investor-relations sites: same format (falls back to SEC_USER_AGENT when unset)
IR_USER_AGENT="Credit Event Radar (student research project) contact@example.com"

# Alerts (optional: local HTML/JSON rendering is always active)
TEAMS_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=
